{#
/**
 * @file
 * LinkedIn feed post: 48px circular avatar, name with "· 1st" degree, a
 * headline line, "time · globe", a "+ Follow" affordance, body (LinkedIn shows
 * "…more" after ~140 chars), full-width media, a reactions count row, then the
 * Like / Comment / Repost / Send bar. Body comes from field_description_linkedin.
 */
#}
{% import '@drubuzz_social_preview/_icons.html.twig' as icons %}

<article class="sp sp--linkedin">
  <div class="li-post">
    <header class="li-post__head">
      {% include '@drubuzz_social_preview/_avatar.html.twig' with { post: post, modifier: 'sp-avatar--round sp-avatar--lg' } %}
      <div class="li-post__id">
        <div class="li-post__name">{{ post.author_name }}<span class="li-post__degree"> · 1st</span></div>
        {% if post.headline %}<div class="li-post__headline">{{ post.headline }}</div>{% endif %}
        <div class="li-post__meta">
          <time datetime="{{ post.datetime }}">{{ post.timestamp }}</time>
          <span class="li-post__sep">·</span>{{ icons.ui('globe') }}
        </div>
      </div>
      <span class="li-post__follow">+ Follow</span>
    </header>

    <div class="li-post__body" data-clamp="true">{{ post.body|nl2br }}</div>

    {% if post.image %}
      <div class="li-post__media">{{ post.image }}</div>
    {% endif %}

    <div class="li-post__stats">
      <span class="li-post__reacts" aria-hidden="true">
        <span class="li-react li-react--like">{{ icons.ui('thumb') }}</span>
        <span class="li-react li-react--heart">{{ icons.ui('heart') }}</span>
      </span>
      <span class="li-post__statlabel">{{ 'You and others'|t }}</span>
    </div>

    <div class="li-post__actions">
      <span class="li-post__action">{{ icons.ui('thumb') }}<span>{{ 'Like'|t }}</span></span>
      <span class="li-post__action">{{ icons.ui('comment') }}<span>{{ 'Comment'|t }}</span></span>
      <span class="li-post__action">{{ icons.ui('repost') }}<span>{{ 'Repost'|t }}</span></span>
      <span class="li-post__action">{{ icons.ui('send') }}<span>{{ 'Send'|t }}</span></span>
    </div>
  </div>
</article>
{% include '@drubuzz_social_preview/_meta.html.twig' with { post: post } %}
